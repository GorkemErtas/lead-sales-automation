APP_NAME=Lead Sales Automation
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lead_sales

# n8n calls the API through this base URL.
# Local Docker Compose:
API_BASE_URL=http://api:8000

# Production n8n examples:
# N8N_HOST=n8n.example.com
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://n8n.example.com/
# N8N_EDITOR_BASE_URL=https://n8n.example.com/
